<section class="section">
  <div class="container">
    <div class="section__head">
      <h2 class="section__title">{{ section.settings.heading }}</h2>
    </div>
    <div class="tiles">
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign url = block.settings.link
          if url == blank and col != blank
            assign url = col.url
          endif
          assign title = block.settings.title
          if title == blank and col != blank
            assign title = col.title
          endif
        -%}
        <a class="tile" href="{{ url | default: routes.all_products_collection_url }}" {{ block.shopify_attributes }}>
          <span class="tile__icon">{% render 'icon', icon: block.settings.icon %}</span>
          <span class="tile__title">{{ title }}</span>
          {%- if block.settings.subtitle != blank -%}<span class="tile__sub">{{ block.settings.subtitle }}</span>{%- endif -%}
          <span class="tile__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by category" }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "subtitle", "label": "Subtitle" },
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "url", "id": "link", "label": "Link (overrides collection)" },
        { "type": "select", "id": "icon", "label": "Icon", "default": "box", "options": [
          { "value": "box", "label": "Box" },
          { "value": "star", "label": "Star" },
          { "value": "pokeball", "label": "Ball" },
          { "value": "shield", "label": "Shield" }
        ] }
      ]
    }
  ],
  "presets": [{ "name": "Shop by category" }]
}
{% endschema %}
