{%- assign menu = linklists[section.settings.menu] -%}
<header class="header">
  <div class="header__top container">
    <button class="header__icon header__menu-toggle" type="button" aria-label="Open menu" data-drawer-open>
      {% render 'icon', icon: 'menu' %}
    </button>

    <a class="header__logo" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        {%- assign logo_style = 'max-width: ' | append: settings.logo_width | append: 'px' -%}
        {{ settings.logo | image_url: width: 520 | image_tag: style: logo_style, alt: shop.name, widths: '260,520' }}
      {%- else -%}
        <span class="logo-text"><span class="logo-text__mark">AXIA</span> Collectibles</span>
      {%- endif -%}
    </a>

    <form class="header__search" action="{{ routes.search_url }}" method="get" role="search">
      <input type="hidden" name="type" value="product">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ section.settings.search_placeholder }}" aria-label="Search">
      <button type="submit" aria-label="Search">{% render 'icon', icon: 'search' %}</button>
    </form>

    <div class="header__icons">
      <a class="header__icon header__search-mobile" href="{{ routes.search_url }}" aria-label="Search">{% render 'icon', icon: 'search' %}</a>
      {%- if shop.customer_accounts_enabled -%}
        <a class="header__icon" href="{{ routes.account_url }}" aria-label="Account">{% render 'icon', icon: 'account' %}</a>
      {%- endif -%}
      <a class="header__icon header__cart" href="{{ routes.cart_url }}" aria-label="Cart, {{ cart.item_count }} items">
        {% render 'icon', icon: 'cart' %}
        {%- if cart.item_count > 0 -%}<span class="header__cart-count">{{ cart.item_count }}</span>{%- endif -%}
      </a>
    </div>
  </div>

  <nav class="header__nav" aria-label="Main">
    <ul class="nav container">
      {%- for link in menu.links -%}
        <li class="nav__item{% if link.links != blank %} nav__item--has-children{% endif %}">
          <a href="{{ link.url }}" class="nav__link{% if link.active or link.child_active %} is-active{% endif %}">{{ link.title }}</a>
          {%- if link.links != blank -%}
            <ul class="nav__dropdown">
              {%- for child in link.links -%}
                <li><a href="{{ child.url }}">{{ child.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </nav>

  <div class="drawer" data-drawer hidden>
    <div class="drawer__panel">
      <div class="drawer__head">
        <span class="logo-text"><span class="logo-text__mark">AXIA</span> Collectibles</span>
        <button class="header__icon" type="button" aria-label="Close menu" data-drawer-close>{% render 'icon', icon: 'close' %}</button>
      </div>
      <form class="drawer__search" action="{{ routes.search_url }}" method="get" role="search">
        <input type="hidden" name="type" value="product">
        <input type="search" name="q" placeholder="{{ section.settings.search_placeholder }}" aria-label="Search">
      </form>
      <ul class="drawer__nav">
        {%- for link in menu.links -%}
          <li>
            <a href="{{ link.url }}">{{ link.title }}</a>
            {%- if link.links != blank -%}
              <ul>
                {%- for child in link.links -%}<li><a href="{{ child.url }}">{{ child.title }}</a></li>{%- endfor -%}
              </ul>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "Header",
  "class": "section-header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder", "default": "Search ETBs, booster boxes, sets..." }
  ]
}
{% endschema %}
