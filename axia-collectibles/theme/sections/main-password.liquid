<section class="hero hero--full">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="container hero__center">
    <span class="logo-text logo-text--light logo-text--xl"><span class="logo-text__mark">AXIA</span> Collectibles</span>
    <h1 class="hero__title">Opening soon.</h1>
    <p class="hero__text">{{ shop.password_message | default: 'Authentic sealed Pokémon TCG is on the way. Get notified the moment we launch.' }}</p>
    {%- form 'customer', class: 'newsletter__form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="newsletter__success">You're on the list!</p>
      {%- else -%}
        <input type="email" name="contact[email]" required placeholder="Email address" aria-label="Email address">
        <button type="submit" class="btn btn--accent">Notify me</button>
      {%- endif -%}
    {%- endform -%}
    <details class="password-login">
      <summary>Store owner? Enter password</summary>
      {%- form 'storefront_password' -%}
        <input type="password" name="password" placeholder="Password" aria-label="Password">
        <button type="submit" class="btn">Enter</button>
        {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{ "name": "Password page" }
{% endschema %}
