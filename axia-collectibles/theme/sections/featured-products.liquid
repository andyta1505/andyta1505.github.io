{%- liquid
  assign col = section.settings.collection
  if col == blank
    assign col = collections.all
  endif
-%}
<section class="section">
  <div class="container">
    <div class="section__head">
      <h2 class="section__title">{{ section.settings.heading }}</h2>
      <a class="section__link" href="{{ col.url | default: routes.all_products_collection_url }}">View all &rarr;</a>
    </div>
    <div class="grid">
      {%- for product in col.products limit: section.settings.limit -%}
        {% render 'product-card', card_product: product %}
      {%- else -%}
        <p class="empty">Products you add in Shopify will appear here.</p>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New arrivals" },
    { "type": "collection", "id": "collection", "label": "Collection", "info": "Leave empty to show all products." },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 24, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
