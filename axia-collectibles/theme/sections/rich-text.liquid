<section class="section">
  <div class="container rich-text">
    {%- if section.settings.heading != blank -%}<h2 class="section__title">{{ section.settings.heading }}</h2>{%- endif -%}
    <div class="rte">{{ section.settings.text }}</div>
    {%- if section.settings.button_label != blank -%}
      <a class="btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "About Axia Collectibles" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We're collectors first. Every box we sell is authentic and factory-sealed, and it's packed the way we'd want our own collection shipped.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Rich text" }]
}
{% endschema %}
