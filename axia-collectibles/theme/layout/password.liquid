<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }} – Opening soon</title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">
  <style>:root{--color-primary:{{ settings.color_primary }};--color-dark:{{ settings.color_dark }};--color-accent:{{ settings.color_accent }};--color-bg:{{ settings.color_background }};--color-text:{{ settings.color_text }};--color-sale:{{ settings.color_sale }};}</style>
  {{ 'axia.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body class="password-body">
  {{ content_for_layout }}
</body>
</html>
