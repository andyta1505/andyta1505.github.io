<section class="container section auth">
  <h1 class="page-head__title">Reset your password</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <label class="field-label" for="Password">New password</label>
    <input class="input" type="password" id="Password" name="customer[password]" autocomplete="new-password" required>
    <label class="field-label" for="PasswordConfirm">Confirm password</label>
    <input class="input" type="password" id="PasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
    <button class="btn btn--block" type="submit">Reset password</button>
  {%- endform -%}
</section>
